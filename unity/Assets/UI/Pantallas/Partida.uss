/* RF-10, RF-16, RF-19, CU-08: pantallas de la partida, en px de 1920 × 1080
   (docs/ux/sistema-visual.md §6). USS no tiene box-shadow: la sombra sólida es un
   contenedor .sombra y el halo del foco, un contenedor .halo. */
.raiz {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Sin los márgenes del tema: las medidas son las del diseño */
.unity-label {
    margin: 0;
    padding: 0;
}

.pantalla {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.pantalla.activa {
    display: flex;
}

/* Fondo quieto: degradado suave en B, franjas tenues en A */
.fondo {
    background-color: var(--fondo);
    background-image: url("../Fondos/FondoOscuro.svg");
    -unity-background-scale-mode: stretch-to-fill;
}

.tema-claro .fondo {
    background-image: url("../Fondos/FondoClaro.svg");
}

.titulo {
    font-size: 72px;
}

.instruccion {
    font-size: 56px;
}

.apoyo {
    -unity-font-definition: url("../Fuentes/Nunito-Bold.ttf");
    color: var(--texto-suave);
}

/* --- Íconos: los de un color se tiñen con el tema --- */
.icono {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--texto);
}

.icono--audio { background-image: url("../Iconos/UiAudio.svg"); }
.icono--boton { background-image: url("../Iconos/UiBoton.svg"); }
.icono--celular { background-image: url("../Iconos/UiCelular.svg"); }
.icono--inclinar { background-image: url("../Iconos/UiInclinar.svg"); }
.icono--jugar { background-image: url("../Iconos/UiJugar.svg"); }
.icono--reiniciar { background-image: url("../Iconos/UiReiniciar.svg"); }
.icono--reloj { background-image: url("../Iconos/UiReloj.svg"); }
.icono--salir { background-image: url("../Iconos/UiSalir.svg"); }

/* El gesto de cada juego: inclinar por defecto, latigazo en Corta */
.icono--gesto { background-image: url("../Iconos/UiInclinar.svg"); }
.juego--corta-sin-fallar .icono--gesto { background-image: url("../Iconos/UiSwing.svg"); }

.icono--suave {
    -unity-background-image-tint-color: var(--texto-suave);
}

.icono--oscuro {
    -unity-background-image-tint-color: var(--accion-tinta);
}

.icono--grande {
    width: 52px;
    height: 52px;
}

/* El ícono de cada juego lo elige la clase juego--<id> que pone el código */
.icono-juego {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.juego--atrapa-lo-correcto .icono-juego {
    background-image: url("../Iconos/JuegoAtrapa.svg");
}

.juego--corta-sin-fallar .icono-juego {
    background-image: url("../Iconos/JuegoCorta.svg");
}

.estrella {
    flex-shrink: 0;
    background-image: url("../Iconos/Estrella.svg");
    -unity-background-scale-mode: scale-to-fit;
}

/* --- Piezas comunes --- */
.sombra {
    background-color: var(--tarjeta-sombra);
    padding-bottom: 10px;
}

.logo {
    position: absolute;
    left: 96px;
    top: 54px;
    height: 80px;
    flex-direction: row;
    align-items: center;
}

.logo .unity-label {
    font-size: 48px;
    letter-spacing: -0.5px;
}

.logo__mente {
    color: var(--marca);
}

.pildora {
    height: 72px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 28px;
    border-width: 3px;
    border-color: var(--tarjeta-borde);
    border-radius: 36px;
    background-color: var(--tarjeta);
}

.pildora .unity-label {
    margin-left: 14px;
    font-size: 32px;
}

.pildora--juego {
    padding-left: 8px;
}

.pildora--esquina {
    position: absolute;
    left: 96px;
    top: 54px;
}

.redondo {
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-color: var(--tarjeta-borde);
    border-radius: 36px;
    background-color: var(--tarjeta);
}

.redondo--grande {
    width: 104px;
    height: 104px;
    border-width: 4px;
    border-radius: 52px;
}

.redondo-sombra {
    margin-left: 32px;
    padding-bottom: 8px;
    border-radius: 52px;
}

/* El foco: borde, halo, fondo y tamaño a la vez, nunca solo color (RF-08) */
.halo {
    padding: 14px;
    border-radius: 74px;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.halo--opcion {
    border-radius: 54px;
}

.halo.foco {
    background-color: var(--foco-halo);
    scale: 1.06 1.06;
}

/* Acción principal: verde, con texto oscuro porque el blanco no alcanza contraste */
.boton-accion {
    height: 120px;
    flex-direction: row;
    align-items: center;
    padding-left: 40px;
    padding-right: 56px;
    border-width: 8px;
    border-color: var(--accion);
    border-radius: 60px;
    background-color: var(--accion);
}

.boton-accion .unity-label {
    margin-left: 18px;
    font-size: 44px;
    color: var(--accion-tinta);
}

.foco > .boton-accion {
    border-color: var(--foco);
}

.icono--accion {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: var(--accion-tinta);
}

.sombra--boton {
    border-radius: 60px;
}

.boton-tarjeta {
    height: 120px;
    flex-direction: row;
    align-items: center;
    padding-left: 40px;
    padding-right: 56px;
    border-width: 4px;
    border-color: var(--tarjeta-borde);
    border-radius: 60px;
    background-color: var(--tarjeta);
}

.boton-tarjeta .unity-label {
    margin-left: 18px;
    font-size: 44px;
}

.icono--accion-tarjeta {
    width: 48px;
    height: 48px;
}

.foco .sombra--boton {
    background-color: var(--foco-sombra);
    padding-bottom: 16px;
}

.foco .boton-tarjeta {
    padding-left: 36px;
    padding-right: 52px;
    border-width: 8px;
    border-color: var(--foco);
    background-color: var(--tarjeta-foco);
}

/* --- 1 · Sala --- */
.qr-sombra {
    position: absolute;
    left: 200px;
    top: 196px;
    padding-bottom: 12px;
    border-radius: 44px;
}

.qr-tarjeta {
    width: 600px;
    height: 600px;
    padding: 40px;
    border-width: 4px;
    border-color: var(--qr-borde);
    border-radius: 44px;
    background-color: #ffffff;
}

.qr {
    width: 512px;
    height: 512px;
    -unity-background-scale-mode: scale-to-fit;
}

.sala__titulo {
    position: absolute;
    left: 900px;
    top: 210px;
    flex-direction: row;
    align-items: center;
}

.sala__titulo .redondo {
    margin-left: 24px;
}

.codigo {
    position: absolute;
    left: 900px;
    top: 340px;
    flex-direction: row;
}

.tecla-sombra {
    margin-right: 20px;
    border-radius: 32px;
}

.tecla {
    width: 180px;
    height: 220px;
    border-width: 4px;
    border-color: var(--tarjeta-borde);
    border-radius: 32px;
    background-color: var(--tarjeta);
    font-size: 160px;
    -unity-text-align: middle-center;
}

.sala__apoyo {
    position: absolute;
    left: 900px;
    top: 600px;
    font-size: 44px;
}

.chip-mando {
    position: absolute;
    left: 900px;
    top: 700px;
    height: 104px;
    flex-direction: row;
    align-items: center;
    padding-left: 20px;
    padding-right: 44px;
    border-width: 4px;
    border-color: var(--punteado);
    border-radius: 52px;
}

.chip-mando__pozo {
    width: 64px;
    height: 64px;
    margin-right: 20px;
    align-items: center;
    justify-content: center;
    border-radius: 32px;
    background-color: var(--pozo);
}

.chip-mando__texto {
    font-size: 40px;
    color: var(--texto-suave);
}

/* --- 4 · Instrucciones --- */
.instr__fila {
    position: absolute;
    left: 0;
    right: 0;
    top: 150px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.demo {
    position: absolute;
    left: 410px;
    top: 290px;
    width: 1100px;
    height: 520px;
    overflow: hidden;
    border-width: 4px;
    border-color: var(--barra-borde);
    border-radius: 48px;
    background-color: var(--barra);
}

/* El celular se inclina ±18° sobre su base y la canasta se mueve ±170 px */
.demo__celular {
    position: absolute;
    left: 471px;
    top: 16px;
    width: 150px;
    height: 270px;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    padding-bottom: 26px;
    border-width: 10px;
    border-color: #0b1f26;
    border-radius: 30px;
    background-color: #f3f8f9;
    transform-origin: 50% 85%;
}

.demo__numero {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: var(--pad1);
    color: var(--pad1-tinta);
    font-size: 26px;
    -unity-text-align: middle-center;
}

.demo__boton {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    background-color: var(--acierto);
}

.demo__canasta {
    position: absolute;
    left: 416px;
    top: 376px;
    width: 260px;
    height: 120px;
    border-top-width: 4px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 14px;
    border-top-color: var(--canasta-borde);
    border-left-color: var(--canasta-borde);
    border-right-color: var(--canasta-borde);
    border-bottom-color: var(--canasta-sombra);
    border-bottom-left-radius: 130px;
    border-bottom-right-radius: 130px;
    background-color: var(--canasta);
}

/* Demostración de swing: el celular da un latigazo desde abajo a la izquierda y
   la fruta que está en la franja se parte en dos */
.demo .solo-swing {
    display: none;
}

.demo--swing .solo-swing {
    display: flex;
}

.demo--swing .solo-inclinar {
    display: none;
}

.demo--swing .demo__celular {
    left: 170px;
    top: 214px;
}

.demo__banda {
    position: absolute;
    left: 0;
    right: 0;
    top: 100px;
    height: 150px;
    background-color: var(--tarjeta);
}

.demo__fruta {
    position: absolute;
    left: 610px;
    top: 120px;
    width: 55px;
    height: 110px;
    background-color: #f59a3e;
}

/* La cara del corte, más clara, para que se lea "partida" */
.demo__fruta--izquierda {
    border-top-left-radius: 55px;
    border-bottom-left-radius: 55px;
    border-right-width: 8px;
    border-right-color: #ffd29e;
}

.demo__fruta--derecha {
    left: 665px;
    border-top-right-radius: 55px;
    border-bottom-right-radius: 55px;
    border-left-width: 8px;
    border-left-color: #ffd29e;
}

.demo__tajo {
    position: absolute;
    left: 330px;
    top: 170px;
    width: 640px;
    height: 12px;
    border-radius: 6px;
    background-color: #f3f8f9;
    rotate: -6deg;
    opacity: 0;
}

.instr__empezar {
    position: absolute;
    left: 0;
    right: 0;
    top: 858px;
    flex-direction: row;
    justify-content: center;
}

/* --- 5 · Cuenta regresiva --- */
.velo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--velo);
}

.velo--suave {
    background-color: var(--velo-suave);
}

.cuenta-sombra {
    position: absolute;
    left: 740px;
    top: 180px;
    padding-bottom: 14px;
    border-radius: 220px;
}

.cuenta__numero {
    width: 440px;
    height: 440px;
    border-width: 8px;
    border-color: var(--tarjeta-borde);
    border-radius: 220px;
    background-color: var(--tarjeta);
    font-size: 240px;
    -unity-text-align: middle-center;
}

.cuenta__pista {
    position: absolute;
    left: 0;
    right: 0;
    top: 680px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.icono--pista {
    width: 64px;
    height: 64px;
    margin-right: 24px;
}

/* --- 6 · HUD --- */
.hud-pildora {
    position: absolute;
    top: 54px;
    height: 96px;
    flex-direction: row;
    align-items: center;
    border-width: 3px;
    border-color: var(--tarjeta-borde);
    border-radius: 48px;
    background-color: var(--hud);
}

.hud-tiempo {
    left: 96px;
    padding-left: 24px;
    padding-right: 32px;
}

.icono--hud {
    width: 48px;
    height: 48px;
}

.barra {
    width: 340px;
    height: 28px;
    margin-left: 20px;
    margin-right: 20px;
    overflow: hidden;
    border-radius: 14px;
    background-color: var(--tiempo-pista);
}

.barra__relleno {
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background-color: var(--tiempo-relleno);
}

/* Tiempo por acabarse: amarillo, nunca rojo */
.barra__relleno.poco-tiempo {
    background-color: var(--estrella);
}

.hud-tiempo__valor {
    min-width: 120px;
    font-size: 56px;
    -unity-text-align: middle-right;
}

.hud-puntaje {
    right: 96px;
    padding-left: 24px;
    padding-right: 36px;
}

.estrella--hud {
    width: 60px;
    height: 60px;
    margin-right: 16px;
}

.hud-puntaje__valor {
    font-size: 64px;
}

.mas-diez {
    position: absolute;
    right: 110px;
    top: 170px;
    font-size: 80px;
    color: var(--acierto);
    opacity: 0;
}

.racha {
    position: absolute;
    right: 96px;
    top: 280px;
    height: 56px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 28px;
    background-color: var(--acierto);
    color: var(--accion-tinta);
    font-size: 32px;
    -unity-text-align: middle-center;
    opacity: 0;
}

/* Acierto y error: el error es más fino, más suave y más corto */
.destello {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
}

.destello--acierto {
    border-width: 16px;
    border-color: var(--acierto);
}

.destello--error {
    border-width: 10px;
    border-color: var(--error);
}

/* --- 7 y 9 · Capas: el juego se sigue viendo detrás --- */
.capa {
    background-color: var(--velo);
}

.panel-sombra {
    position: absolute;
    padding-bottom: 16px;
    border-radius: 56px;
    background-color: var(--foco-sombra);
}

.panel-sombra--pausa {
    left: 520px;
    top: 200px;
}

.panel-sombra--espera {
    left: 400px;
    top: 250px;
}

.panel {
    border-width: 4px;
    border-color: var(--tarjeta-borde);
    border-radius: 56px;
    background-color: var(--panel);
}

.panel--pausa {
    width: 880px;
    height: 680px;
    justify-content: center;
    padding: 42px 66px;
}

.panel__titulo {
    margin-bottom: 34px;
    -unity-text-align: middle-center;
}

.opcion {
    height: 120px;
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    border-width: 4px;
    border-color: var(--tarjeta-borde);
    border-radius: 40px;
    background-color: var(--opcion);
}

.opcion .unity-label {
    font-size: 44px;
}

.opcion--alta {
    height: 140px;
}

.opcion .opcion__nota {
    font-size: 32px;
}

.foco > .opcion {
    padding-left: 28px;
    padding-right: 28px;
    border-width: 8px;
    border-color: var(--foco);
    background-color: var(--tarjeta-foco);
}

.opcion__pozo {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 36px;
    background-color: var(--pozo);
}

.opcion__pozo--seguir {
    background-color: var(--acierto);
}

.panel--espera {
    width: 1120px;
    height: 580px;
    align-items: center;
    justify-content: center;
    padding: 0 80px;
}

.panel--espera .titulo {
    margin-bottom: 28px;
}

.perdido {
    width: 200px;
    height: 200px;
    margin-bottom: 36px;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: var(--punteado);
    border-radius: 100px;
}

.icono--perdido {
    width: 112px;
    height: 112px;
}

.perdido__numero {
    position: absolute;
    right: 0;
    top: 4px;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: var(--pad1);
    color: var(--pad1-tinta);
    font-size: 36px;
    -unity-text-align: middle-center;
}

.panel__ayuda {
    font-size: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* --- 8 · Resultados --- */
.estrellas {
    position: absolute;
    left: 0;
    right: 0;
    top: 96px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.estrella--lado {
    width: 210px;
    height: 210px;
}

.estrella--centro {
    width: 260px;
    height: 260px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 40px;
}

.res__titulo {
    position: absolute;
    left: 0;
    right: 0;
    top: 410px;
    -unity-text-align: middle-center;
}

.res__puntaje {
    position: absolute;
    left: 0;
    right: 0;
    top: 500px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.res__puntos {
    font-size: 144px;
}

.res__unidad {
    margin-left: 20px;
    margin-bottom: 30px;
    font-size: 40px;
}

.res__resumen {
    position: absolute;
    left: 0;
    right: 0;
    top: 700px;
    font-size: 32px;
    -unity-text-align: middle-center;
}

.res__record {
    position: absolute;
    align-self: center;
    top: 660px;
    padding: 8px 28px;
    border-radius: 24px;
    background-color: var(--estrella);
    color: #3a2a06;
    font-size: 32px;
    -unity-text-align: middle-center;
}

.res__mejor {
    position: absolute;
    left: 0;
    right: 0;
    top: 752px;
    font-size: 30px;
    -unity-text-align: middle-center;
}

.res__acciones {
    position: absolute;
    left: 0;
    right: 0;
    top: 846px;
    flex-direction: row;
    justify-content: center;
}

.res__acciones > .halo {
    margin-left: 14px;
    margin-right: 14px;
}
