# Normalizar finales de línea: se commitea LF, cada quien trabaja con lo suyo
* text=auto eol=lf

# Windows
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Unity: forzar merge manual, estos archivos no se fusionan solos
*.unity      merge=binary eol=lf
*.prefab     merge=binary eol=lf
*.asset      merge=binary eol=lf
*.mat        merge=binary eol=lf
*.anim       merge=binary eol=lf
*.controller merge=binary eol=lf
*.meta       text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.fbx binary
*.blend binary
*.psd binary
*.ttf binary
*.otf binary
*.unitypackage binary

# Si los assets crecen mucho, activar Git LFS (requiere `git lfs install` en
# cada máquina del equipo) descomentando estas líneas y acordándolo entre los tres:
# *.psd filter=lfs diff=lfs merge=lfs -text
